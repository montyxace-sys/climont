# Redirecciones de servidor (Netlify y, si se volviera a Cloudflare, Workers Assets).
# Formato: origen  destino  código
#
# Las URLs heredadas del sitio antiguo (osCommerce) siguen apareciendo en
# Search Console. Cada regla devuelve un 301 real, sin pasar por JavaScript.
#
# Nota: las redirecciones de producto /productos/<uuid> -> /productos/<slug>
# se añaden solas en cada build desde scripts/prerender.mjs.

/index.php     /catalogo   301
/index.php/*   /catalogo   301
/web/*         /catalogo   301
/EUR/*         /catalogo   301
/index.html    /            301
/tel*          /            301

# Entradas del blog publicadas desde el panel que todavía no tienen su HTML
# estático: Netlify sirve la SPA (200) solo si no existe el fichero, así que
# las rutas ya prerenderizadas conservan su HTML propio.
/blog/*        /index.html  200

# Catch-all SPA fallback
/*    /index.html    200

