{
  "name": "climont",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "climont.es/*", "zone_name": "climont.es" },
    { "pattern": "www.climont.es/*", "zone_name": "climont.es" }
  ]
}
