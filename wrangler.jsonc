{
  "name": "climont",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "climont.es/*", "zone_name": "climont.es" },
    { "pattern": "www.climont.es/*", "zone_name": "climont.es" }
  ]
}
